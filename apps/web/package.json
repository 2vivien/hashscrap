{
  "name": "@hashscrap/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:stack": "node scripts/dev-stack.mjs",
    "stack:ready": "docker compose -f ../../compose.yaml up -d db && docker compose -f ../../compose.yaml run --rm app alembic upgrade head",
    "stack:down": "docker compose -f ../../compose.yaml down",
    "stack:logs": "docker compose -f ../../compose.yaml logs -f app",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "vite build && tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.120.5",
    "@tanstack/react-start": "^1.120.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
