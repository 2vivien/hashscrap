# Data source used by the interface: "api" reads the engine, "mock" reads the
# typed JSON fixtures shipped with each feature.
VITE_DATA_SOURCE=api

# Base URL of the versioned engine API. Leave it unset to use the dev proxy
# configured in vite.config.ts.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
